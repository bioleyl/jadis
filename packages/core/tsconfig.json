  "compilerOptions": {
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "removeComments": true,
    "rootDir": "./src",
    "target": "es2023"
  },
  "exclude": ["dist", "playwright.config.ts", "tests", "vitest.config.ts"],
  "extends": "../../tsconfig.base.json",
  "include": ["**/*.ts"]
}

  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "homepage": "https://bioleyl.github.io/jadis/server-rendering/overview",
  "keywords": [
    "jadis",
    "fastify",
    "fastify-plugin",
    "ssr",
    "server rendering",
    "declarative shadow dom",
    "web components",
    "custom elements"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@jadis/fastify",
  "peerDependencies": {
    "@jadis/core": "^1.7.0",
    "fastify": "^5.0.0"
  },
  "repository": {
    "directory": "packages/fastify",
    "type": "git",
    "url": "git+https://github.com/bioleyl/jadis.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"test/**/*.test.mjs\""
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.7.0"
